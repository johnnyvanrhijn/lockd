# Supabase — public client credentials only.
# The service role key MUST NOT be added to this file or to .env.local;
# it has full admin rights and would be inlined into the browser bundle
# by Next.js NEXT_PUBLIC_* exposure.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Personal Access Token — used by the Supabase MCP server
# (.mcp.json) so Claude Code can introspect / modify your project.
# Generate one at https://supabase.com/dashboard/account/tokens
#
# This is NOT a Next.js variable. Next won't load it from .env.local
# into the browser bundle — that's the whole point. It must be present
# in the shell environment when you launch Claude Code:
#   PowerShell:  $env:SUPABASE_ACCESS_TOKEN = "sbp_..."
#   Persistent:  setx SUPABASE_ACCESS_TOKEN "sbp_..."  (new shells)
SUPABASE_ACCESS_TOKEN=sbp_your_personal_access_token
